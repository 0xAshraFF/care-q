rules_version = '2';

// /wards/{wardId}     public read. Built-in wards (src/data/hospitals.ts) only store status here;
//                     doctor-added wards also store nameBn + custom: true.
// /doctors/{uid}      a doctor's profile, role 'doctor' or 'incharge'. `approved` is set by the
//                     ward's in-charge (for doctors) or the app admin (for in-charges, and for
//                     anyone asking for a new ward). Until then the doctor sees what patients see.
// /transfers/{id}     a referral from one ward to another. Readable by the sender and by approved
//                     doctors of the receiving ward, who accept or decline it.
// /config/admins      { emails: [...] } — the app owner's Gmail address(es): approves in-charges.
//                     Create it by hand in the Firebase console. Clients can't write it.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function doctorPath() {
      return /databases/$(database)/documents/doctors/$(request.auth.uid);
    }

    // Registered AND approved.
    function isDoctor() {
      return signedIn() && exists(doctorPath()) && get(doctorPath()).data.approved == true;
    }

    function isWardDoctor(wardId) {
      return isDoctor() && get(doctorPath()).data.wardId == wardId;
    }

    // An approved in-charge of this ward.
    function isInchargeOf(wardId) {
      return isDoctor() && get(doctorPath()).data.role == 'incharge' && get(doctorPath()).data.wardId == wardId;
    }

    // The app owner.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }

    function me() {
      return get(doctorPath()).data;
    }

    function validStatusWrite() {
      let d = request.resource.data;
      let beds = d.get('freeBeds', null);
      return d.status in ['open', 'emergency', 'full']
        // Optional free-bed count (11 = "more than 10"); none when the ward is full.
        && (beds == null || (beds is int && beds >= 1 && beds <= 11 && d.status != 'full'))
        && d.updatedAt == request.time
        && d.updatedByUid == request.auth.uid;
    }

    match /config/admins {
      // Readable only by the admins it lists, which doubles as the client's "am I an admin?" check.
      allow get: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in resource.data.emails;
    }

    match /wards/{wardId} {
      allow read: if true;

      allow create: if
        // A ward missing from the built-in list. Pending doctors ask for one; the admin creates it.
        ((isDoctor() || isAdmin())
          && request.resource.data.keys().hasOnly(['hospitalId', 'nameBn', 'custom', 'createdByUid', 'createdAt'])
          && request.resource.data.custom == true
          && request.resource.data.hospitalId is string
          && request.resource.data.hospitalId.size() <= 40
          && request.resource.data.nameBn is string
          && request.resource.data.nameBn.size() >= 2
          && request.resource.data.nameBn.size() <= 60
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time)
        ||
        // First status report for a built-in ward.
        (isWardDoctor(wardId)
          && request.resource.data.keys().hasOnly(['hospitalId', 'status', 'freeBeds', 'updatedAt', 'updatedByUid'])
          && request.resource.data.hospitalId == me().hospitalId
          && validStatusWrite());

      // Only approved doctors of this ward can change its status, and nothing else about it.
      allow update: if isWardDoctor(wardId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'freeBeds', 'updatedAt', 'updatedByUid'])
        && validStatusWrite();

      // Admins can remove a doctor-added ward (e.g. a duplicate).
      allow delete: if isAdmin() && resource.data.custom == true;
    }

    match /transfers/{transferId} {
      // Queries must filter on fromDoctorUid == me or toWardId == my ward for these to pass.
      allow get, list: if isDoctor()
        && (resource.data.fromDoctorUid == request.auth.uid || resource.data.toWardId == me().wardId);

      allow create: if isDoctor()
        && request.resource.data.keys().hasOnly(['hospitalId', 'fromWardId', 'toWardId', 'fromDoctorUid',
             'fromDoctorName', 'fromDoctorPhone', 'patientNote', 'patientInfo', 'status', 'createdAt'])
        && request.resource.data.fromDoctorUid == request.auth.uid
        && request.resource.data.fromDoctorName == me().name
        && request.resource.data.fromDoctorPhone == me().phone
        && request.resource.data.fromWardId == me().wardId
        && request.resource.data.hospitalId == me().hospitalId
        && request.resource.data.toWardId is string
        && request.resource.data.toWardId.size() > 0
        && request.resource.data.toWardId.size() <= 100
        && request.resource.data.toWardId != request.resource.data.fromWardId
        && request.resource.data.patientNote is string
        && request.resource.data.patientNote.size() >= 2
        && request.resource.data.patientNote.size() <= 300
        && request.resource.data.patientInfo is string
        && request.resource.data.patientInfo.size() <= 60
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if isDoctor() && resource.data.status == 'pending' && (
        // A doctor of the receiving ward accepts or declines, signing with their own name and number.
        (resource.data.toWardId == me().wardId
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondedAt', 'respondedByUid', 'respondedByName', 'respondedByPhone'])
          && request.resource.data.respondedAt == request.time
          && request.resource.data.respondedByUid == request.auth.uid
          && request.resource.data.respondedByName == me().name
          && request.resource.data.respondedByPhone == me().phone)
        ||
        // The sender cancels.
        (resource.data.fromDoctorUid == request.auth.uid
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.respondedAt == request.time)
      );

      allow delete: if false;
    }

    match /doctors/{uid} {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'phone', 'role', 'hospitalId', 'wardId', 'newWardName', 'approved', 'dutyUntil', 'updatedAt'])
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
          && d.phone is string && d.phone.matches('^01[3-9][0-9]{8}$')
          && d.role in ['doctor', 'incharge']
          && d.hospitalId is string && d.hospitalId.size() <= 40
          && d.wardId is string && d.wardId.size() <= 100
          && d.newWardName is string && d.newWardName.size() <= 60
          // Either a ward from the list, or a request for a new one.
          && (d.wardId.size() > 0 || d.newWardName.size() >= 2)
          && d.approved is bool
          && (d.dutyUntil == null
              || (d.approved == true
                  && d.dutyUntil is timestamp
                  && d.dutyUntil <= request.time + duration.value(25, 'h')))
          && d.updatedAt == request.time;
      }

      allow get: if signedIn() && (request.auth.uid == uid || isDoctor() || isAdmin());
      allow list: if isDoctor() || isAdmin();

      allow create: if signedIn() && request.auth.uid == uid
        && validProfile()
        && request.resource.data.approved == false;

      // A doctor edits their own profile. Approval is for this person, role and ward: it survives only
      // while name, role and ward stay the same.
      allow update: if signedIn() && request.auth.uid == uid
        && validProfile()
        && request.resource.data.approved == (resource.data.approved == true
             && request.resource.data.name == resource.data.name
             && request.resource.data.role == resource.data.role
             && request.resource.data.wardId == resource.data.wardId);

      // A ward's in-charge approves or revokes doctors (not in-charges) of that ward, nothing else.
      allow update: if resource.data.role == 'doctor'
        && isInchargeOf(resource.data.wardId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'dutyUntil'])
        && request.resource.data.approved is bool
        && (request.resource.data.dutyUntil == resource.data.dutyUntil || request.resource.data.dutyUntil == null);

      // The app admin approves anyone, revokes (clearing any duty), and assigns the ward they created on approval.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved', 'wardId', 'newWardName', 'dutyUntil'])
        && request.resource.data.approved is bool
        && request.resource.data.wardId is string && request.resource.data.wardId.size() <= 100
        && request.resource.data.newWardName is string && request.resource.data.newWardName.size() <= 60
        && (request.resource.data.dutyUntil == resource.data.dutyUntil || request.resource.data.dutyUntil == null);

      allow delete: if signedIn()
        && (request.auth.uid == uid || isAdmin() || (resource.data.role == 'doctor' && isInchargeOf(resource.data.wardId)));
    }
  }
}
